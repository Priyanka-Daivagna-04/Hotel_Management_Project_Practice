<!-- Page Header -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
  <div>
    <h1 class="h3 fw-bold mb-1 text-dark">Housekeeping & Maintenance</h1>
    <p class="text-muted small mb-0">Track room hygiene, sanitation tasks, turnaround schedules, and maintenance repairs.</p>
  </div>
  <a href="/housekeeping/new" class="btn btn-gold">
    <i class="bi bi-calendar-plus me-1"></i> Schedule Task
  </a>
</div>

<!-- Housekeeping Status Metrics -->
<div class="row g-3 mb-4">
  <div class="col-6 col-md-3">
    <div class="stat-card">
      <div>
        <div class="stat-label">Pending Cleaning</div>
        <div class="stat-value text-danger"><%= pendingCount %></div>
        <small class="text-muted">Awaiting housekeeper</small>
      </div>
      <div class="stat-icon red"><i class="bi bi-hourglass-split"></i></div>
    </div>
  </div>

  <div class="col-6 col-md-3">
    <div class="stat-card">
      <div>
        <div class="stat-label">In Progress</div>
        <div class="stat-value text-primary"><%= inProgressCount %></div>
        <small class="text-muted">Currently being serviced</small>
      </div>
      <div class="stat-icon blue"><i class="bi bi-brush"></i></div>
    </div>
  </div>

  <div class="col-6 col-md-3">
    <div class="stat-card">
      <div>
        <div class="stat-label">Completed Today</div>
        <div class="stat-value text-success"><%= completedCount %></div>
        <small class="text-muted">Inspected & cleared</small>
      </div>
      <div class="stat-icon green"><i class="bi bi-check2-all"></i></div>
    </div>
  </div>

  <div class="col-6 col-md-3">
    <div class="stat-card">
      <div>
        <div class="stat-label">Rooms in Maintenance</div>
        <div class="stat-value text-warning"><%= dirtyRooms.filter(r => r.status === 'Maintenance').length %></div>
        <small class="text-muted">Requires repair / clean</small>
      </div>
      <div class="stat-icon gold"><i class="bi bi-tools"></i></div>
    </div>
  </div>
</div>

<!-- Dirty Rooms Quick Attention Banner -->
<% const maintenanceRooms = dirtyRooms.filter(r => r.status === 'Maintenance'); %>
<% if (maintenanceRooms.length > 0) { %>
  <div class="alert alert-warning d-flex flex-wrap align-items-center justify-content-between mb-4 shadow-sm" role="alert">
    <div class="d-flex align-items-center gap-2 mb-2 mb-md-0">
      <i class="bi bi-exclamation-triangle-fill fs-4 text-warning"></i>
      <div>
        <strong>Rooms Awaiting Service:</strong>
        <span>The following rooms are flagged for maintenance or post-checkout sanitization:</span>
        <div class="d-flex flex-wrap gap-1 mt-1">
          <% maintenanceRooms.forEach(r => { %>
            <a href="/housekeeping/new?roomId=<%= r._id %>" class="badge bg-warning text-dark text-decoration-none">
              Room <%= r.roomNumber %> <i class="bi bi-plus-circle ms-1"></i>
            </a>
          <% }); %>
        </div>
      </div>
    </div>
  </div>
<% } %>

<!-- Filter Toolbar -->
<div class="luxury-card p-3 mb-4">
  <form action="/housekeeping" method="GET" class="row g-2 align-items-center">
    <div class="col-6 col-md-3">
      <select name="status" class="form-select" onchange="this.form.submit()">
        <option value="all" <%= selectedStatus === 'all' ? 'selected' : '' %>>All Statuses</option>
        <option value="Pending" <%= selectedStatus === 'Pending' ? 'selected' : '' %>>Pending</option>
        <option value="In Progress" <%= selectedStatus === 'In Progress' ? 'selected' : '' %>>In Progress</option>
        <option value="Completed" <%= selectedStatus === 'Completed' ? 'selected' : '' %>>Completed</option>
      </select>
    </div>

    <div class="col-6 col-md-3">
      <select name="priority" class="form-select" onchange="this.form.submit()">
        <option value="all" <%= selectedPriority === 'all' ? 'selected' : '' %>>All Priorities</option>
        <option value="Urgent" <%= selectedPriority === 'Urgent' ? 'selected' : '' %>>Urgent</option>
        <option value="High" <%= selectedPriority === 'High' ? 'selected' : '' %>>High</option>
        <option value="Medium" <%= selectedPriority === 'Medium' ? 'selected' : '' %>>Medium</option>
        <option value="Low" <%= selectedPriority === 'Low' ? 'selected' : '' %>>Low</option>
      </select>
    </div>

    <div class="col-6 col-md-3">
      <select name="taskType" class="form-select" onchange="this.form.submit()">
        <option value="all" <%= selectedType === 'all' ? 'selected' : '' %>>All Task Types</option>
        <option value="Daily Cleaning" <%= selectedType === 'Daily Cleaning' ? 'selected' : '' %>>Daily Cleaning</option>
        <option value="Deep Clean" <%= selectedType === 'Deep Clean' ? 'selected' : '' %>>Deep Clean</option>
        <option value="Checkout Clean" <%= selectedType === 'Checkout Clean' ? 'selected' : '' %>>Checkout Clean</option>
        <option value="Maintenance Repair" <%= selectedType === 'Maintenance Repair' ? 'selected' : '' %>>Maintenance Repair</option>
        <option value="Inspection" <%= selectedType === 'Inspection' ? 'selected' : '' %>>Inspection</option>
      </select>
    </div>

    <div class="col-6 col-md-3 d-flex gap-2">
      <button type="submit" class="btn btn-navy flex-grow-1">Filter</button>
      <% if (selectedStatus !== 'all' || selectedPriority !== 'all' || selectedType !== 'all') { %>
        <a href="/housekeeping" class="btn btn-outline-secondary" title="Reset Filters"><i class="bi bi-arrow-counterclockwise"></i></a>
      <% } %>
    </div>
  </form>
</div>

<!-- Housekeeping Tasks Table -->
<div class="luxury-card overflow-hidden">
  <% if (tasks && tasks.length > 0) { %>
    <div class="table-responsive">
      <table class="table table-luxury align-middle mb-0">
        <thead>
          <tr>
            <th>Room</th>
            <th>Task Type</th>
            <th>Priority</th>
            <th>Assigned To</th>
            <th>Status</th>
            <th>Remarks</th>
            <th class="text-end">Update Status</th>
          </tr>
        </thead>
        <tbody>
          <% tasks.forEach(task => { %>
            <tr>
              <td>
                <% if (task.room) { %>
                  <a href="/rooms/<%= task.room._id %>" class="fw-bold text-dark text-decoration-none">
                    Room <%= task.room.roomNumber %>
                  </a>
                  <div class="text-muted" style="font-size: 0.75rem;">Status: <%= task.room.status %></div>
                <% } else { %>
                  <span class="text-muted">Unassigned</span>
                <% } %>
              </td>
              <td>
                <span class="fw-semibold text-dark"><%= task.taskType %></span>
                <div class="text-muted" style="font-size: 0.72rem;"><%= new Date(task.createdAt).toLocaleDateString() %></div>
              </td>
              <td>
                <% if (task.priority === 'Urgent') { %>
                  <span class="badge bg-danger">Urgent</span>
                <% } else if (task.priority === 'High') { %>
                  <span class="badge bg-warning text-dark">High</span>
                <% } else if (task.priority === 'Medium') { %>
                  <span class="badge bg-info text-dark">Medium</span>
                <% } else { %>
                  <span class="badge bg-light text-secondary border">Low</span>
                <% } %>
              </td>
              <td>
                <% if (task.assignedTo) { %>
                  <div class="fw-medium text-dark"><%= task.assignedTo.name %></div>
                  <small class="text-muted"><%= task.assignedTo.email %></small>
                <% } else { %>
                  <span class="text-muted fst-italic">Unassigned</span>
                <% } %>
              </td>
              <td>
                <span class="badge-status <%= task.status.replace(/\s+/g, '_') %>"><%= task.status %></span>
              </td>
              <td class="text-muted small" style="max-width: 200px;">
                <%= task.remarks || '—' %>
              </td>
              <td class="text-end">
                <div class="btn-group">
                  <% if (task.status === 'Pending') { %>
                    <form action="/housekeeping/<%= task._id %>/status?_method=PATCH" method="POST" class="d-inline">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <input type="hidden" name="status" value="In Progress">
                      <button type="submit" class="btn btn-sm btn-outline-primary" title="Start Task">
                        <i class="bi bi-play-circle me-1"></i> Start
                      </button>
                    </form>
                  <% } else if (task.status === 'In Progress') { %>
                    <form action="/housekeeping/<%= task._id %>/status?_method=PATCH" method="POST" class="d-inline">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <input type="hidden" name="status" value="Completed">
                      <button type="submit" class="btn btn-sm btn-success" title="Mark Completed & Release Room">
                        <i class="bi bi-check2-circle me-1"></i> Complete
                      </button>
                    </form>
                  <% } else { %>
                    <span class="badge bg-success-subtle text-success py-2 px-3">
                      <i class="bi bi-check-all me-1"></i> Cleared
                    </span>
                  <% } %>

                  <% if (currentUser && currentUser.role === 'Admin') { %>
                    <form action="/housekeeping/<%= task._id %>?_method=DELETE" method="POST" class="d-inline ms-1" onsubmit="return confirm('Remove this housekeeping task?');">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button type="submit" class="btn btn-sm btn-light border text-danger" title="Delete">
                        <i class="bi bi-trash"></i>
                      </button>
                    </form>
                  <% } %>
                </div>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <!-- Pagination -->
    <div class="p-3 border-top">
      <%- include('../partials/pagination') %>
    </div>
  <% } else { %>
    <div class="text-center py-5 text-muted">
      <i class="bi bi-brush fs-1 d-block mb-2 text-secondary"></i>
      <h4 class="text-dark fw-bold">All caught up!</h4>
      <p class="small mb-3">No active housekeeping or maintenance tasks.</p>
      <a href="/housekeeping/new" class="btn btn-gold"><i class="bi bi-plus-lg me-1"></i> Schedule a Cleaning Task</a>
    </div>
  <% } %>
</div>

