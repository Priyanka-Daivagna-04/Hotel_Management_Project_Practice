<!-- Page Header -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
  <div>
    <h1 class="h3 fw-bold mb-1 text-dark">Guest Directory</h1>
    <p class="text-muted small mb-0">Maintain guest records, loyalty history, contact details, and ID verification.</p>
  </div>
  <a href="/guests/new" class="btn btn-gold">
    <i class="bi bi-person-plus me-1"></i> Register New Guest
  </a>
</div>

<!-- Search Bar -->
<div class="luxury-card p-3 mb-4">
  <form action="/guests" method="GET" class="row g-2 align-items-center">
    <div class="col-12 col-md-10">
      <div class="input-group">
        <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-search"></i></span>
        <input type="text" name="search" class="form-control border-start-0" placeholder="Search guests by name, email, phone, or passport ID..." value="<%= searchQuery %>">
      </div>
    </div>
    <div class="col-12 col-md-2 d-flex gap-2">
      <button type="submit" class="btn btn-navy flex-grow-1">Search</button>
      <% if (searchQuery) { %>
        <a href="/guests" class="btn btn-outline-secondary" title="Clear Search"><i class="bi bi-arrow-counterclockwise"></i></a>
      <% } %>
    </div>
  </form>
</div>

<!-- Guests Table -->
<div class="luxury-card overflow-hidden">
  <% if (guests && guests.length > 0) { %>
    <div class="table-responsive">
      <table class="table table-luxury align-middle mb-0">
        <thead>
          <tr>
            <th>Guest Name</th>
            <th>Contact Details</th>
            <th>Identification</th>
            <th>Nationality</th>
            <th>Registered Date</th>
            <th class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% guests.forEach(guest => { %>
            <tr>
              <td>
                <a href="/guests/<%= guest._id %>" class="fw-bold text-dark text-decoration-none">
                  <%= guest.firstName %> <%= guest.lastName %>
                </a>
              </td>
              <td>
                <div class="small text-dark"><i class="bi bi-envelope me-1 text-muted"></i><%= guest.email %></div>
                <div class="small text-muted"><i class="bi bi-telephone me-1 text-muted"></i><%= guest.phone %></div>
              </td>
              <td>
                <span class="badge bg-light text-dark border"><%= guest.idType %></span>
                <span class="small font-monospace text-muted ms-1"><%= guest.idNumber || '—' %></span>
              </td>
              <td><%= guest.nationality || '—' %></td>
              <td class="text-muted small"><%= formatDateIN(guest.createdAt) %></td>
              <td class="text-end">
                <div class="btn-group">
                  <a href="/guests/<%= guest._id %>" class="btn btn-sm btn-light border" title="View Profile">
                    <i class="bi bi-person-lines-fill"></i>
                  </a>
                  <a href="/guests/<%= guest._id %>/edit" class="btn btn-sm btn-light border" title="Edit">
                    <i class="bi bi-pencil"></i>
                  </a>
                  <% if (currentUser && currentUser.role === 'Admin') { %>
                    <form action="/guests/<%= guest._id %>?_method=DELETE" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to remove this guest profile?');">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                        <i class="bi bi-trash"></i>
                      </button>
                    </form>
                  <% } %>
                </div>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <!-- Pagination -->
    <div class="p-3 border-top">
      <%- include('../partials/pagination') %>
    </div>
  <% } else { %>
    <div class="text-center py-5 text-muted">
      <i class="bi bi-people fs-1 d-block mb-2 text-secondary"></i>
      <h4 class="text-dark fw-bold">No guests found</h4>
      <p class="small mb-3">No guest records match your search.</p>
      <a href="/guests/new" class="btn btn-gold"><i class="bi bi-person-plus me-1"></i> Register a Guest</a>
    </div>
  <% } %>
</div>

