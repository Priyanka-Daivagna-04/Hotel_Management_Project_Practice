<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1 class="h3 fw-bold mb-1 text-dark">Register Guest</h1>
    <p class="text-muted small mb-0">Add a new guest record into the hotel management system.</p>
  </div>
  <a href="/guests" class="btn btn-outline-secondary">
    <i class="bi bi-arrow-left me-1"></i> Back to Guests
  </a>
</div>

<div class="luxury-card p-4 mx-auto" style="max-width: 800px;">
  <form action="/guests" method="POST">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <h5 class="fw-bold text-dark mb-3"><i class="bi bi-person text-warning me-2"></i>Personal Details</h5>
    <div class="row g-3 mb-4">
      <div class="col-12 col-md-6">
        <label for="firstName" class="form-label">First Name <span class="text-danger">*</span></label>
        <input type="text" class="form-control" id="firstName" name="firstName" placeholder="e.g. Liam" required>
      </div>

      <div class="col-12 col-md-6">
        <label for="lastName" class="form-label">Last Name <span class="text-danger">*</span></label>
        <input type="text" class="form-control" id="lastName" name="lastName" placeholder="e.g. Vance" required>
      </div>

      <div class="col-12 col-md-6">
        <label for="email" class="form-label">Email Address <span class="text-danger">*</span></label>
        <input type="email" class="form-control" id="email" name="email" placeholder="liam.vance@example.com" required>
      </div>

      <div class="col-12 col-md-6">
        <label for="phone" class="form-label">Phone Number <span class="text-danger">*</span></label>
        <input type="tel" class="form-control" id="phone" name="phone" placeholder="+91 98765 43210" required>
      </div>
    </div>

    <h5 class="fw-bold text-dark mb-3 border-top pt-3"><i class="bi bi-card-text text-primary me-2"></i>Identification & Nationality</h5>
    <div class="row g-3 mb-4">
      <div class="col-12 col-md-4">
        <label for="idType" class="form-label">ID Type</label>
        <select class="form-select" id="idType" name="idType">
          <option value="Aadhaar Card" selected>Aadhaar Card</option>
          <option value="PAN Card">PAN Card</option>
          <option value="Driving License">Driving License</option>
          <option value="Voter ID">Voter ID</option>
          <option value="Passport">Passport</option>
          <option value="Other">Other</option>
        </select>
      </div>

      <div class="col-12 col-md-4">
        <label for="idNumber" class="form-label">Aadhaar / ID Number</label>
        <input type="text" class="form-control font-monospace" id="idNumber" name="idNumber" placeholder="e.g. 5421 9876 1234">
      </div>

      <div class="col-12 col-md-4">
        <label for="nationality" class="form-label">Nationality</label>
        <input type="text" class="form-control" id="nationality" name="nationality" value="Indian" placeholder="e.g. Indian">
      </div>
    </div>

    <h5 class="fw-bold text-dark mb-3 border-top pt-3"><i class="bi bi-geo-alt text-danger me-2"></i>Residential Address</h5>
    <div class="row g-3 mb-4">
      <div class="col-12">
        <label for="street" class="form-label">Street Address</label>
        <input type="text" class="form-control" id="street" name="street" placeholder="100 Kensington High St">
      </div>

      <div class="col-12 col-md-4">
        <label for="city" class="form-label">City</label>
        <input type="text" class="form-control" id="city" name="city" placeholder="London">
      </div>

      <div class="col-12 col-md-3">
        <label for="state" class="form-label">State / Province</label>
        <input type="text" class="form-control" id="state" name="state" placeholder="Greater London">
      </div>

      <div class="col-12 col-md-3">
        <label for="country" class="form-label">Country</label>
        <input type="text" class="form-control" id="country" name="country" placeholder="United Kingdom">
      </div>

      <div class="col-12 col-md-2">
        <label for="zipCode" class="form-label">Zip / Postcode</label>
        <input type="text" class="form-control" id="zipCode" name="zipCode" placeholder="W8 4SG">
      </div>
    </div>

    <div class="mb-4">
      <label for="specialRequests" class="form-label">Guest Preferences & Notes</label>
      <textarea class="form-control" id="specialRequests" name="specialRequests" rows="3" placeholder="Frequent traveler preferences, dietary restrictions, favorite room floor, etc."></textarea>
    </div>

    <div class="d-flex justify-content-end gap-2 pt-3 border-top">
      <a href="/guests" class="btn btn-outline-secondary">Cancel</a>
      <button type="submit" class="btn btn-gold">
        <i class="bi bi-check2-circle me-1"></i> Save Guest
      </button>
    </div>
  </form>
</div>

