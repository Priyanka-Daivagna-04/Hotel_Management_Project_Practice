<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sign In | Grand Royale Hotel & Resorts</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="auth-page">
  <div class="auth-card">
    <div class="auth-brand">
      <div class="d-inline-flex p-3 rounded-circle mb-3" style="background: rgba(197, 160, 89, 0.15); border: 1px solid var(--hotel-gold);">
        <i class="bi bi-gem fs-2" style="color: var(--hotel-gold-hover);"></i>
      </div>
      <h2 class="h3 brand-title text-dark mb-1">Grand Royale</h2>
      <p class="text-muted small text-uppercase tracking-wider">Hospitality Management Portal</p>
    </div>

    <!-- Flash Messages -->
    <%- include('../partials/alerts') %>

    <form action="/auth/login" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="mb-3">
        <label for="email" class="form-label">Email Address</label>
        <div class="input-group">
          <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-envelope"></i></span>
          <input type="email" class="form-control border-start-0" id="email" name="email" placeholder="name@grandroyale.com" required autofocus>
        </div>
      </div>

      <div class="mb-4">
        <div class="d-flex justify-content-between align-items-center mb-1">
          <label for="password" class="form-label mb-0">Password</label>
          <span class="small text-muted">Protected Session</span>
        </div>
        <div class="input-group">
          <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-shield-lock"></i></span>
          <input type="password" class="form-control border-start-0" id="password" name="password" placeholder="••••••••" required>
        </div>
      </div>

      <button type="submit" class="btn btn-gold w-100 py-2 fs-6 mb-4">
        <i class="bi bi-box-arrow-in-right me-2"></i> Sign In to Portal
      </button>
    </form>

    <!-- Quick Role Credentials Helper -->
    <div class="border-top pt-3">
      <p class="small text-muted text-center mb-2 fw-semibold">Demo Role Presets (Click to autofill):</p>
      <div class="d-grid gap-2">
        <button type="button" class="btn btn-sm btn-outline-secondary text-start d-flex justify-content-between align-items-center" onclick="autofill('admin@grandroyale.com', 'AdminPassword123!')">
          <span><i class="bi bi-shield-fill-check text-primary me-2"></i>Admin</span>
          <small class="text-muted">Full Control</small>
        </button>
        <button type="button" class="btn btn-sm btn-outline-secondary text-start d-flex justify-content-between align-items-center" onclick="autofill('reception@grandroyale.com', 'ReceptionPassword123!')">
          <span><i class="bi bi-person-badge-fill text-success me-2"></i>Receptionist</span>
          <small class="text-muted">Bookings & Front Desk</small>
        </button>
        <button type="button" class="btn btn-sm btn-outline-secondary text-start d-flex justify-content-between align-items-center" onclick="autofill('housekeeping@grandroyale.com', 'CleanPassword123!')">
          <span><i class="bi bi-brush-fill text-warning me-2"></i>Housekeeping</span>
          <small class="text-muted">Tasks & Room Status</small>
        </button>
      </div>
    </div>
  </div>

  <script>
    function autofill(email, password) {
      document.getElementById('email').value = email;
      document.getElementById('password').value = password;
    }
  </script>
</body>
</html>
