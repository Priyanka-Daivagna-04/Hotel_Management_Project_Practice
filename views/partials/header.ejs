<header class="top-header">
  <div class="header-left d-flex align-items-center gap-3">
    <button class="btn-sidebar-toggle" id="sidebarToggle" type="button" aria-label="Toggle navigation" title="Toggle Sidebar">
      <i class="bi bi-list"></i>
    </button>
    <span class="header-title-badge text-nowrap d-none d-sm-inline-flex align-items-center">
      <i class="bi bi-stars text-warning me-1"></i> Luxury Hospitality Management
    </span>
  </div>

  <div class="header-right d-flex align-items-center gap-3 ms-auto">
    <div class="header-time text-nowrap" id="liveClock"></div>

    <% if (currentUser && (currentUser.role === 'Admin' || currentUser.role === 'Receptionist')) { %>
      <a href="/bookings/new" class="btn btn-sm btn-gold text-nowrap d-none d-md-inline-flex align-items-center gap-1">
        <i class="bi bi-plus-circle"></i> New Reservation
      </a>
    <% } %>

    <!-- User Profile Dropdown -->
    <% if (currentUser) { %>
      <div class="dropdown">
        <button class="btn btn-link text-decoration-none p-0 d-flex align-items-center gap-2 dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
          <img src="<%= currentUser.avatar || '/images/default-avatar.png' %>" alt="<%= currentUser.name %>" class="rounded-circle" width="36" height="36" style="border: 2px solid var(--hotel-gold);" onerror="this.src='https://ui-avatars.com/api/?name=<%= encodeURIComponent(currentUser.name) %>&background=0f172a&color=c5a059'">
          <span class="d-none d-lg-inline text-dark fw-semibold fs-6"><%= currentUser.name %></span>
        </button>
        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 py-2" style="border-radius: var(--radius-sm); min-width: 200px;">
          <li class="px-3 py-2 border-bottom">
            <div class="fw-bold text-dark"><%= currentUser.name %></div>
            <div class="text-muted small"><%= currentUser.email %></div>
            <span class="badge bg-light text-dark border mt-1"><%= currentUser.role %></span>
          </li>
          <li>
            <a class="dropdown-item py-2" href="/auth/profile">
              <i class="bi bi-person-gear me-2 text-muted"></i> Account Profile
            </a>
          </li>
          <% if (currentUser.role === 'Admin') { %>
            <li>
              <a class="dropdown-item py-2" href="/staff">
                <i class="bi bi-shield-check me-2 text-muted"></i> Staff Directory
              </a>
            </li>
          <% } %>
          <li><hr class="dropdown-divider"></li>
          <li>
            <form action="/auth/logout" method="POST" class="m-0">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="dropdown-item text-danger py-2">
                <i class="bi bi-box-arrow-right me-2"></i> Sign Out
              </button>
            </form>
          </li>
        </ul>
      </div>
    <% } %>
  </div>
</header>
