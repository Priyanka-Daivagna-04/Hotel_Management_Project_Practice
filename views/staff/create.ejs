<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1 class="h3 fw-bold mb-1 text-dark">Add Staff Member</h1>
    <p class="text-muted small mb-0">Create staff employment profile and grant portal credentials.</p>
  </div>
  <a href="/staff" class="btn btn-outline-secondary">
    <i class="bi bi-arrow-left me-1"></i> Back to Staff Directory
  </a>
</div>

<div class="luxury-card p-4 mx-auto" style="max-width: 800px;">
  <form action="/staff" method="POST">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <h5 class="fw-bold text-dark mb-3"><i class="bi bi-person-lock text-warning me-2"></i>Account & Access Role</h5>
    <div class="row g-3 mb-4">
      <div class="col-12 col-md-6">
        <label for="name" class="form-label">Full Name <span class="text-danger">*</span></label>
        <input type="text" class="form-control" id="name" name="name" placeholder="e.g. Liam Sterling" required>
      </div>

      <div class="col-12 col-md-6">
        <label for="email" class="form-label">Login Email <span class="text-danger">*</span></label>
        <input type="email" class="form-control" id="email" name="email" placeholder="liam@grandroyale.com" required>
      </div>

      <div class="col-12 col-md-6">
        <label for="password" class="form-label">Initial Password <span class="text-danger">*</span></label>
        <input type="password" class="form-control" id="password" name="password" placeholder="At least 6 characters" required>
      </div>

      <div class="col-12 col-md-6">
        <label for="role" class="form-label">System Role <span class="text-danger">*</span></label>
        <select class="form-select" id="role" name="role" required>
          <option value="Receptionist" selected>Receptionist (Front Desk)</option>
          <option value="Housekeeping Staff">Housekeeping Staff (Tasks & Rooms)</option>
          <option value="Admin">Admin (Full System Privilege)</option>
        </select>
      </div>

      <div class="col-12 col-md-6">
        <label for="phone" class="form-label">Phone Number</label>
        <input type="tel" class="form-control" id="phone" name="phone" placeholder="+1 (555) 019-2233">
      </div>
    </div>

    <h5 class="fw-bold text-dark mb-3 border-top pt-3"><i class="bi bi-briefcase text-primary me-2"></i>Employment Details</h5>
    <div class="row g-3 mb-4">
      <div class="col-12 col-md-6">
        <label for="employeeId" class="form-label">Employee ID <span class="text-danger">*</span></label>
        <input type="text" class="form-control font-monospace text-uppercase" id="employeeId" name="employeeId" placeholder="e.g. EMP-2026-05" required>
      </div>

      <div class="col-12 col-md-6">
        <label for="department" class="form-label">Department <span class="text-danger">*</span></label>
        <select class="form-select" id="department" name="department" required>
          <option value="Front Desk" selected>Front Desk</option>
          <option value="Management">Management</option>
          <option value="Housekeeping">Housekeeping</option>
          <option value="Maintenance">Maintenance</option>
          <option value="Food & Beverage">Food & Beverage</option>
        </select>
      </div>

      <div class="col-12 col-md-4">
        <label for="designation" class="form-label">Job Designation <span class="text-danger">*</span></label>
        <input type="text" class="form-control" id="designation" name="designation" placeholder="e.g. Senior Concierge" required>
      </div>

      <div class="col-12 col-md-4">
        <label for="shift" class="form-label">Shift Timing</label>
        <select class="form-select" id="shift" name="shift">
          <option value="Morning" selected>Morning</option>
          <option value="Evening">Evening</option>
          <option value="Night">Night</option>
          <option value="General">General</option>
        </select>
      </div>

      <div class="col-12 col-md-4">
        <label for="salary" class="form-label">Annual Salary (₹)</label>
        <div class="input-group">
          <span class="input-group-text">₹</span>
          <input type="number" class="form-control" id="salary" name="salary" placeholder="480000">
        </div>
      </div>
    </div>

    <h5 class="fw-bold text-dark mb-3 border-top pt-3"><i class="bi bi-shield-heart text-danger me-2"></i>Emergency Contact</h5>
    <div class="row g-3 mb-4">
      <div class="col-12 col-md-4">
        <label for="emergencyName" class="form-label">Contact Name</label>
        <input type="text" class="form-control" id="emergencyName" name="emergencyName" placeholder="e.g. Sarah Vance">
      </div>
      <div class="col-12 col-md-4">
        <label for="emergencyRelation" class="form-label">Relationship</label>
        <input type="text" class="form-control" id="emergencyRelation" name="emergencyRelation" placeholder="e.g. Spouse, Sibling">
      </div>
      <div class="col-12 col-md-4">
        <label for="emergencyPhone" class="form-label">Contact Phone</label>
        <input type="tel" class="form-control" id="emergencyPhone" name="emergencyPhone" placeholder="+1 (555) 019-9988">
      </div>
    </div>

    <div class="d-flex justify-content-end gap-2 pt-3 border-top">
      <a href="/staff" class="btn btn-outline-secondary">Cancel</a>
      <button type="submit" class="btn btn-gold">
        <i class="bi bi-check2-circle me-1"></i> Register Staff Member
      </button>
    </div>
  </form>
</div>

