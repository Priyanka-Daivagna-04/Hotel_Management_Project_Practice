<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
  <div>
    <h1 class="h3 fw-bold mb-1 text-dark"><%= staff.user ? staff.user.name : staff.employeeId %></h1>
    <p class="text-muted small mb-0">Staff Profile • ID: <span class="font-monospace fw-semibold"><%= staff.employeeId %></span></p>
  </div>
  <div class="d-flex gap-2">
    <a href="/staff" class="btn btn-outline-secondary">
      <i class="bi bi-arrow-left me-1"></i> Staff Directory
    </a>
    <a href="/staff/<%= staff._id %>/edit" class="btn btn-gold">
      <i class="bi bi-pencil me-1"></i> Edit Profile
    </a>
  </div>
</div>

<div class="row g-4 mx-auto" style="max-width: 900px;">
  <!-- Profile Summary Card -->
  <div class="col-12 col-md-5">
    <div class="luxury-card p-4 text-center">
      <img src="https://ui-avatars.com/api/?name=<%= encodeURIComponent(staff.user ? staff.user.name : 'Staff') %>&background=0f172a&color=c5a059&size=100" class="rounded-circle mb-3 shadow-sm" alt="Avatar">
      <h5 class="fw-bold text-dark mb-1"><%= staff.user ? staff.user.name : 'Unknown' %></h5>
      <p class="text-muted small mb-2"><%= staff.designation %></p>
      
      <div class="d-flex justify-content-center gap-2 mb-3">
        <span class="badge <%= staff.user && staff.user.role === 'Admin' ? 'bg-primary' : (staff.user && staff.user.role === 'Receptionist' ? 'bg-success' : 'bg-warning text-dark') %>">
          <%= staff.user ? staff.user.role : 'No Role' %>
        </span>
        <% if (staff.isActive) { %>
          <span class="badge bg-success-subtle text-success border border-success-subtle">Active Account</span>
        <% } else { %>
          <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Deactivated</span>
        <% } %>
      </div>

      <div class="text-start border-top pt-3 small">
        <div class="mb-2">
          <span class="text-muted d-block">Official Email</span>
          <strong class="text-dark"><%= staff.user ? staff.user.email : 'N/A' %></strong>
        </div>
        <div class="mb-2">
          <span class="text-muted d-block">Phone Number</span>
          <strong class="text-dark"><%= staff.user ? staff.user.phone : 'N/A' %></strong>
        </div>
        <div class="mb-2">
          <span class="text-muted d-block">Joined On</span>
          <strong class="text-dark"><%= new Date(staff.dateOfJoining).toLocaleDateString() %></strong>
        </div>
      </div>
    </div>
  </div>

  <!-- Employment & Departmental Data -->
  <div class="col-12 col-md-7">
    <div class="luxury-card p-4 mb-4">
      <h5 class="fw-bold text-dark mb-3"><i class="bi bi-briefcase text-warning me-2"></i>Employment Details</h5>
      <ul class="list-group list-group-flush mb-0">
        <li class="list-group-item d-flex justify-content-between px-0 py-2">
          <span class="text-muted">Employee ID</span>
          <span class="font-monospace fw-bold text-dark"><%= staff.employeeId %></span>
        </li>
        <li class="list-group-item d-flex justify-content-between px-0 py-2">
          <span class="text-muted">Department</span>
          <span class="fw-semibold text-dark"><%= staff.department %></span>
        </li>
        <li class="list-group-item d-flex justify-content-between px-0 py-2">
          <span class="text-muted">Assigned Shift</span>
          <span class="fw-semibold text-dark"><%= staff.shift %> Shift</span>
        </li>
        <li class="list-group-item d-flex justify-content-between px-0 py-2">
          <span class="text-muted">Annual Compensation</span>
          <span class="fw-bold text-success"><%= formatINR(staff.salary) %> / yr</span>
        </li>
      </ul>
    </div>

    <!-- Emergency Contact -->
    <div class="luxury-card p-4">
      <h5 class="fw-bold text-dark mb-3"><i class="bi bi-shield-heart text-danger me-2"></i>Emergency Contact</h5>
      <% if (staff.emergencyContact && staff.emergencyContact.name) { %>
        <div class="d-flex justify-content-between mb-2">
          <span class="text-muted">Contact Name:</span>
          <span class="fw-semibold text-dark"><%= staff.emergencyContact.name %></span>
        </div>
        <div class="d-flex justify-content-between mb-2">
          <span class="text-muted">Relationship:</span>
          <span class="fw-semibold text-dark"><%= staff.emergencyContact.relation %></span>
        </div>
        <div class="d-flex justify-content-between">
          <span class="text-muted">Phone Number:</span>
          <span class="fw-semibold text-dark"><%= staff.emergencyContact.phone %></span>
        </div>
      <% } else { %>
        <p class="text-muted small mb-0">No emergency contact information on file.</p>
      <% } %>
    </div>
  </div>
</div>

