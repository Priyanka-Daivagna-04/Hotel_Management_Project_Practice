<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1 class="h3 fw-bold mb-1 text-dark">Record Payment</h1>
    <p class="text-muted small mb-0">Record and issue receipts for guest folio charges and deposits.</p>
  </div>
  <a href="/payments" class="btn btn-outline-secondary">
    <i class="bi bi-arrow-left me-1"></i> Back to Payments
  </a>
</div>

<div class="luxury-card p-4 mx-auto" style="max-width: 700px;">
  <form action="/payments" method="POST">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <!-- Booking Selection -->
    <div class="mb-3">
      <label for="bookingId" class="form-label">Associated Reservation <span class="text-danger">*</span></label>
      <% if (selectedBooking) { %>
        <input type="hidden" name="bookingId" value="<%= selectedBooking._id %>">
        <div class="p-3 bg-light rounded border">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <strong class="text-dark"><%= selectedBooking.bookingNumber %></strong> • 
              <span><%= selectedBooking.guest ? selectedBooking.guest.firstName + ' ' + selectedBooking.guest.lastName : 'Guest' %></span>
            </div>
            <span class="badge bg-light text-dark border">Room <%= selectedBooking.room ? selectedBooking.room.roomNumber : '' %></span>
          </div>
          <div class="d-flex justify-content-between mt-2 pt-2 border-top small">
            <span class="text-muted">Total: <%= formatINR(selectedBooking.totalPrice) %> | Paid: <%= formatINR(selectedBooking.paidAmount) %></span>
            <span class="fw-bold text-danger">Outstanding Balance: <%= formatINR(selectedBooking.balanceAmount) %></span>
          </div>
        </div>
      <% } else { %>
        <select class="form-select" id="bookingId" name="bookingId" required onchange="updateSuggestedAmount(this)">
          <option value="" disabled selected>Select an active reservation...</option>
          <% activeBookings.forEach(b => { %>
            <option value="<%= b._id %>" data-balance="<%= b.balanceAmount %>">
              <%= b.bookingNumber %> - <%= b.guest ? b.guest.firstName + ' ' + b.guest.lastName : 'Guest' %> (Room <%= b.room ? b.room.roomNumber : '' %>) - Due: <%= formatINR(b.balanceAmount) %>
            </option>
          <% }); %>
        </select>
      <% } %>
    </div>

    <!-- Amount -->
    <div class="mb-3">
      <label for="amount" class="form-label">Payment Amount (₹) <span class="text-danger">*</span></label>
      <div class="input-group">
        <span class="input-group-text">₹</span>
        <input type="number" step="1" class="form-control" id="amount" name="amount" value="<%= selectedBooking ? selectedBooking.balanceAmount.toFixed(2) : '' %>" placeholder="0.00" required>
      </div>
    </div>

    <!-- Method -->
    <div class="mb-3">
      <label for="paymentMethod" class="form-label">Payment Method <span class="text-danger">*</span></label>
      <select class="form-select" id="paymentMethod" name="paymentMethod" required>
        <option value="UPI / Google Pay / PhonePe" selected>UPI / Google Pay / PhonePe</option>
        <option value="Net Banking">Net Banking</option>
        <option value="Credit Card">Credit Card</option>
        <option value="Debit Card">Debit Card</option>
        <option value="Cash">Cash</option>
        <option value="NEFT / RTGS">NEFT / RTGS</option>
      </select>
    </div>

    <!-- Transaction ID -->
    <div class="mb-3">
      <label for="transactionId" class="form-label">Transaction / Reference ID</label>
      <input type="text" class="form-control font-monospace" id="transactionId" name="transactionId" placeholder="e.g. TXN-123456 or POS Terminal Batch #">
      <div class="form-text">Leave blank to auto-generate reference ID.</div>
    </div>

    <!-- Notes -->
    <div class="mb-4">
      <label for="notes" class="form-label">Billing Notes</label>
      <textarea class="form-control" id="notes" name="notes" rows="2" placeholder="e.g. Settlement upon check-out, minibar charges included, deposit, etc."></textarea>
    </div>

    <div class="d-flex justify-content-end gap-2 pt-3 border-top">
      <a href="/payments" class="btn btn-outline-secondary">Cancel</a>
      <button type="submit" class="btn btn-gold">
        <i class="bi bi-check2-circle me-1"></i> Record & Generate Invoice
      </button>
    </div>
  </form>
</div>

<script>
  function updateSuggestedAmount(selectElem) {
    const selectedOption = selectElem.options[selectElem.selectedIndex];
    const balance = selectedOption.getAttribute('data-balance');
    if (balance) {
      document.getElementById('amount').value = parseFloat(balance).toFixed(2);
    }
  }
</script>

