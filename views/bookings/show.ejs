<!-- Header with Print & Actions -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3 no-print">
  <div>
    <div class="d-flex align-items-center gap-2 mb-1">
      <h1 class="h3 fw-bold mb-0 text-dark">Reservation Voucher</h1>
      <span class="badge-status <%= booking.status.replace(/\s+/g, '_') %>"><%= booking.status %></span>
    </div>
    <p class="text-muted small mb-0">Reference: <strong><%= booking.bookingNumber %></strong> • Booked on <%= formatDateIN(booking.createdAt) %></p>
  </div>
  <div class="d-flex gap-2">
    <a href="/bookings" class="btn btn-outline-secondary">
      <i class="bi bi-arrow-left me-1"></i> Bookings List
    </a>
    <button onclick="window.print()" class="btn btn-outline-secondary">
      <i class="bi bi-printer me-1"></i> Print Voucher
    </button>
    <a href="/bookings/<%= booking._id %>/edit" class="btn btn-gold">
      <i class="bi bi-pencil me-1"></i> Edit
    </a>
  </div>
</div>

<!-- Front Desk Operational Action Bar -->
<div class="luxury-card p-3 mb-4 bg-light border-0 no-print">
  <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
    <div class="d-flex align-items-center gap-2">
      <span class="fw-semibold text-dark small text-uppercase"><i class="bi bi-shield-check text-primary me-1"></i>Front Desk Operations:</span>
      
      <% if (booking.status === 'Confirmed') { %>
        <form action="/bookings/<%= booking._id %>/checkin" method="POST" class="d-inline">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn btn-sm btn-success">
            <i class="bi bi-box-arrow-in-right me-1"></i> Complete Check-In
          </button>
        </form>
      <% } else if (booking.status === 'Checked In') { %>
        <form action="/bookings/<%= booking._id %>/checkout" method="POST" class="d-inline" onsubmit="return confirm('Confirm guest departure and process room release?');">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn btn-sm btn-primary">
            <i class="bi bi-box-arrow-right me-1"></i> Process Check-Out
          </button>
        </form>
      <% } %>

      <a href="/payments/new?bookingId=<%= booking._id %>" class="btn btn-sm btn-outline-dark">
        <i class="bi bi-credit-card me-1"></i> Add Payment
      </a>

      <% if (booking.guest) { %>
        <a href="/guests/<%= booking.guest._id %>" class="btn btn-sm btn-outline-secondary">
          <i class="bi bi-person-lines-fill me-1"></i> Guest Directory
        </a>
        <a href="/guests/<%= booking.guest._id %>/edit" class="btn btn-sm btn-outline-secondary">
          <i class="bi bi-pencil me-1"></i> Edit Guest Details
        </a>
      <% } %>
    </div>

    <!-- Cancellation -->
    <% if (booking.status !== 'Cancelled' && booking.status !== 'Checked Out') { %>
      <form action="/bookings/<%= booking._id %>?_method=DELETE" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to cancel this reservation? Room will be released.');">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="btn btn-sm btn-outline-danger">
          <i class="bi bi-x-circle me-1"></i> Cancel Reservation
        </button>
      </form>
    <% } %>
  </div>
</div>

<!-- Voucher Main Container -->
<div class="luxury-card p-4 p-md-5 mb-4">
  <!-- Voucher Header -->
  <div class="d-flex justify-content-between align-items-center border-bottom pb-4 mb-4">
    <div>
      <div class="d-flex align-items-center gap-2 mb-1">
        <i class="bi bi-gem fs-2 text-warning"></i>
        <h3 class="brand-title text-dark mb-0">Grand Royale</h3>
      </div>
      <p class="text-muted small mb-0">Luxury Hotel & Spa • Front Desk Voucher</p>
    </div>
    <div class="text-end">
      <div class="fs-4 fw-bold text-dark"><%= booking.bookingNumber %></div>
      <span class="badge-status <%= booking.paymentStatus.replace(/\s+/g, '_') %>"><%= booking.paymentStatus %></span>
    </div>
  </div>

  <div class="row g-4 mb-4">
    <!-- Guest Info -->
    <div class="col-12 col-md-6">
      <h6 class="text-uppercase text-muted fw-bold small mb-2">Guest Profile</h6>
      <% if (booking.guest) { %>
        <h5 class="fw-bold text-dark mb-1">
          <a href="/guests/<%= booking.guest._id %>" class="text-decoration-none text-dark">
            <%= booking.guest.firstName %> <%= booking.guest.lastName %>
          </a>
        </h5>
        <div class="text-muted small mb-1"><i class="bi bi-envelope me-1"></i> <%= booking.guest.email %></div>
        <div class="text-muted small mb-1"><i class="bi bi-telephone me-1"></i> <%= booking.guest.phone %></div>
        <div class="text-muted small mb-2"><i class="bi bi-card-text me-1"></i> <%= booking.guest.idType %>: <%= booking.guest.idNumber || 'Not specified' %></div>
        <div class="d-flex gap-2 no-print">
          <a href="/guests/<%= booking.guest._id %>" class="btn btn-sm btn-light border py-1 px-2 text-decoration-none">
            <i class="bi bi-person-lines-fill me-1 text-primary"></i> Guest History
          </a>
          <a href="/guests/<%= booking.guest._id %>/edit" class="btn btn-sm btn-light border py-1 px-2 text-decoration-none">
            <i class="bi bi-pencil me-1 text-warning"></i> Update Profile
          </a>
        </div>
      <% } else { %>
        <p class="text-muted small">No guest linked.</p>
      <% } %>
    </div>

    <!-- Room Info -->
    <div class="col-12 col-md-6 text-md-end">
      <h6 class="text-uppercase text-muted fw-bold small mb-2">Room Assigned</h6>
      <% if (booking.room) { %>
        <h5 class="fw-bold text-dark mb-1">
          <a href="/rooms/<%= booking.room._id %>" class="text-decoration-none text-dark">
            Room <%= booking.room.roomNumber %>
          </a>
        </h5>
        <div class="text-muted small mb-1"><%= booking.room.category ? booking.room.category.name : 'Standard' %> • Floor <%= booking.room.floor %></div>
        <div class="text-muted small mb-1">Rate: <%= formatINR(booking.pricePerNight) %> / night</div>
        <div class="text-muted small"><%= booking.adults %> Adult(s), <%= booking.children %> Child(ren)</div>
      <% } else { %>
        <p class="text-muted small">No room assigned.</p>
      <% } %>
    </div>
  </div>

  <!-- Stay Timeline Details -->
  <div class="row g-3 p-3 bg-light rounded mb-4 text-center">
    <div class="col-6 col-md-3">
      <small class="text-muted d-block text-uppercase">Check-In Date</small>
      <span class="fw-bold text-dark fs-6"><%= formatDateIN(booking.checkInDate) %></span>
    </div>
    <div class="col-6 col-md-3">
      <small class="text-muted d-block text-uppercase">Check-Out Date</small>
      <span class="fw-bold text-dark fs-6"><%= formatDateIN(booking.checkOutDate) %></span>
    </div>
    <div class="col-6 col-md-3">
      <small class="text-muted d-block text-uppercase">Duration</small>
      <span class="fw-bold text-dark fs-6"><%= booking.nights %> Night<%= booking.nights > 1 ? 's' : '' %></span>
    </div>
    <div class="col-6 col-md-3">
      <small class="text-muted d-block text-uppercase">Status</small>
      <span class="fw-bold text-dark fs-6"><%= booking.status %></span>
    </div>
  </div>

  <% if (booking.specialRequests) { %>
    <div class="mb-4 p-3 border rounded">
      <strong class="small text-dark d-block mb-1"><i class="bi bi-chat-left-text me-1 text-primary"></i>Special Guest Instructions:</strong>
      <p class="small text-muted mb-0"><%= booking.specialRequests %></p>
    </div>
  <% } %>

  <!-- Financial Summary -->
  <div class="row justify-content-end mb-4">
    <div class="col-12 col-md-6 col-lg-5">
      <ul class="list-group list-group-flush">
        <li class="list-group-item d-flex justify-content-between px-0 py-2">
          <span class="text-muted">Rate (<%= formatINR(booking.pricePerNight) %> x <%= booking.nights %> nights)</span>
          <span class="fw-semibold text-dark"><%= formatINR(booking.totalPrice) %></span>
        </li>
        <li class="list-group-item d-flex justify-content-between px-0 py-2">
          <span class="text-muted">Total Paid / Deposited</span>
          <span class="fw-bold text-success">-<%= formatINR(booking.paidAmount) %></span>
        </li>
        <li class="list-group-item d-flex justify-content-between px-0 py-2 border-top fs-5">
          <span class="fw-bold text-dark">Balance Due</span>
          <span class="fw-bold <%= booking.balanceAmount > 0 ? 'text-danger' : 'text-success' %>">
            <%= formatINR(booking.balanceAmount) %>
          </span>
        </li>
      </ul>
    </div>
  </div>

  <!-- Payment Ledger Table -->
  <div class="border-top pt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h6 class="fw-bold text-dark mb-0"><i class="bi bi-receipt text-warning me-2"></i>Payment Transactions</h6>
      <a href="/payments/new?bookingId=<%= booking._id %>" class="btn btn-sm btn-outline-secondary no-print">
        <i class="bi bi-plus-lg me-1"></i> Record Payment
      </a>
    </div>

    <% if (payments && payments.length > 0) { %>
      <div class="table-responsive">
        <table class="table table-sm table-luxury align-middle mb-0">
          <thead>
            <tr>
              <th>Invoice #</th>
              <th>Date</th>
              <th>Method</th>
              <th>Amount</th>
              <th>Status</th>
              <th class="text-end no-print">Receipt</th>
            </tr>
          </thead>
          <tbody>
            <% payments.forEach(p => { %>
              <tr>
                <td class="fw-semibold"><%= p.invoiceNumber %></td>
                <td><%= formatDateIN(p.createdAt) %></td>
                <td><%= p.paymentMethod %></td>
                <td class="fw-bold text-dark"><%= formatINR(p.amount) %></td>
                <td><span class="badge-status <%= p.status %>"><%= p.status %></span></td>
                <td class="text-end no-print">
                  <a href="/payments/<%= p._id %>/invoice" class="btn btn-sm btn-light border">
                    <i class="bi bi-file-earmark-text"></i> Invoice
                  </a>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <p class="text-muted small mb-0">No payment records found for this reservation.</p>
    <% } %>
  </div>
</div>

