<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Grand Royale Hotel</title>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Plus+Jakarta+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="d-flex align-items-center justify-content-center bg-light min-vh-100 p-4">
  <div class="luxury-card text-center p-5 shadow-lg" style="max-width: 550px; border-radius: var(--radius-lg);">
    <div class="display-1 fw-bold text-danger mb-3 font-monospace"><%= errorCode %></div>
    <h2 class="mb-3"><%= title %></h2>
    <p class="text-muted mb-4 lead fs-6"><%= errorMessage %></p>

    <% if (typeof errorStack !== 'undefined' && errorStack) { %>
      <div class="text-start bg-dark text-light p-3 rounded mb-4 overflow-auto" style="max-height: 200px; font-size: 0.75rem;">
        <pre class="m-0"><code><%= errorStack %></code></pre>
      </div>
    <% } %>

    <div class="d-flex justify-content-center gap-3">
      <a href="javascript:history.back()" class="btn btn-outline-secondary px-4">
        <i class="bi bi-arrow-left me-1"></i> Go Back
      </a>
      <a href="/dashboard" class="btn btn-gold px-4">
        <i class="bi bi-speedometer2 me-1"></i> Dashboard
      </a>
    </div>
  </div>
</body>
</html>
