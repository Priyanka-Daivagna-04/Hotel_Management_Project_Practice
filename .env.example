# ========================================================
# GRAND ROYALE HOTEL MANAGEMENT SYSTEM - ENVIRONMENT CONFIG
# ========================================================

# Server Port & Mode
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Atlas Recommended for AWS Deployment)
# Replace with your MongoDB Atlas connection string from cloud.mongodb.com:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/hotel_management?retryWrites=true&w=majority
# Fallback for local testing:
# MONGODB_URI=mongodb://127.0.0.1:27017/hotel_management

# Express Session Security
SESSION_SECRET=grand_royale_hotel_production_session_secret_replace_this_with_random_64_bytes
SESSION_CRYPTO_SECRET=grand_royale_crypto_salt_9876543210

# AWS Deployment Settings
AWS_REGION=us-east-1
# AWS_S3_BUCKET_NAME=grand-royale-hotel-uploads
# AWS_ACCESS_KEY_ID=your-aws-access-key-id
# AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

